/* ===== ScreenStreamPipeline.swift ===== */

/* Alert iOS shows when the screen broadcast fails to start; %@ = the system's error text */
"Could not open the streaming port (%@). If the LensLink camera is streaming, stop it first — a device can send the camera or the screen, not both." = "Could not open the streaming port (%@). If the LensLink camera is streaming, stop it first — a device can send the camera or the screen, not both.";

/* Alert iOS shows when OBS never connects to the screen broadcast; %@ = technical listener state for bug reports */
"OBS did not connect within 30 seconds [%@]. Check OBS has a LensLink Screen source pointing at this phone (USB, or this phone's Wi-Fi IP) — a LensLink Camera source won't accept a screen broadcast — and the camera stream isn't running." = "OBS did not connect within 30 seconds [%@]. Check OBS has a LensLink Screen source pointing at this phone (USB, or this phone's Wi-Fi IP) — a LensLink Camera source won't accept a screen broadcast — and the camera stream isn't running.";

/* ===== StreamClient.swift ===== */

/* Status line error: the app couldn't open the network port OBS connects to (USB and Wi-Fi) */
"Could not open USB listener" = "Could not open USB listener";

/* ===== VideoEncoder.swift ===== */

/* Status line error: %1$@ = codec name (HEVC or H.264), %2$lld = system error code */
"%1$@ encoder unavailable (%2$lld)" = "%1$@ encoder unavailable (%2$lld)";
