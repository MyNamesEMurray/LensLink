			"Encoder": {
				"layout": "$B1",
				"Icon": "imgs/actions/white-balance-key",
				"TriggerDescription": {
					"Rotate": "Temperature",
					"Push": "Auto"
				}
			}
		},
		{
			"Name": "Calibrate white balance",
			"UUID": "cam.lenslink.streamdeck.calibrate",
			"Icon": "imgs/actions/calibrate",
			"Tooltip": "Hold white paper or a gray card in the middle of the picture, then press.",
			"PropertyInspectorPath": "ui/calibrate.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/calibrate-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Exposure",
			"UUID": "cam.lenslink.streamdeck.exposure",
			"Icon": "imgs/actions/exposure",
			"Tooltip": "Key: step EV up or down, or set it. Dial: turn for EV, press for 0.",
			"PropertyInspectorPath": "ui/exposure.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/exposure-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"Icon": "imgs/actions/exposure-key",
				"TriggerDescription": {
					"Rotate": "Exposure",
					"Push": "Reset to 0 EV"
				}
			}
		},
		{
			"Name": "ISO and shutter",
			"UUID": "cam.lenslink.streamdeck.iso",
			"Icon": "imgs/actions/iso",
			"Tooltip": "Dial: turn for ISO or shutter, press to switch between them, tap the screen for auto exposure.",
			"PropertyInspectorPath": "ui/iso.html",
			"Controllers": [
				"Encoder"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/iso-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"Icon": "imgs/actions/iso-key",
				"TriggerDescription": {
					"Rotate": "ISO or shutter",
					"Push": "Switch ISO / shutter",
					"Touch": "Auto exposure"
				}
			}
		},
		{
			"Name": "Focus",
			"UUID": "cam.lenslink.streamdeck.focus",
			"Icon": "imgs/actions/focus",
			"Tooltip": "Key: auto focus, face focus or a saved position. Dial: turn to focus, press for auto.",
			"PropertyInspectorPath": "ui/focus.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/focus-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"Icon": "imgs/actions/focus-key",
				"TriggerDescription": {
					"Rotate": "Focus",
					"Push": "Auto"
				}
			}
		},
		{
			"Name": "Green screen",
			"UUID": "cam.lenslink.streamdeck.green-screen",
			"Icon": "imgs/actions/green-screen",
			"Tooltip": "Cut out the background on the phone.",
			"PropertyInspectorPath": "ui/green-screen.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/green-screen-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Format",
			"UUID": "cam.lenslink.streamdeck.format",
			"Icon": "imgs/actions/format",
			"Tooltip": "Switch resolution, frame rate and codec in one press.",
			"PropertyInspectorPath": "ui/format.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/format-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Microphone",
			"UUID": "cam.lenslink.streamdeck.mic",
			"Icon": "imgs/actions/mic",
			"Tooltip": "Pick which phone mic feeds the source.",
			"PropertyInspectorPath": "ui/mic.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/mic-key",
