{
	"Name": "LensLink",
	"Version": "0.1.0.0",
	"Author": "Exalted Pixels",
	"Actions": [
		{
			"Name": "Camera",
			"UUID": "cam.lenslink.streamdeck.camera",
			"Icon": "imgs/actions/camera",
			"Tooltip": "Start or stop the camera on the phone.",
			"PropertyInspectorPath": "ui/camera.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/camera-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Pause",
			"UUID": "cam.lenslink.streamdeck.pause",
			"Icon": "imgs/actions/pause",
			"Tooltip": "Hold the picture without ending the stream.",
			"PropertyInspectorPath": "ui/pause.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/pause-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Flip camera",
			"UUID": "cam.lenslink.streamdeck.flip",
			"Icon": "imgs/actions/flip",
			"Tooltip": "Switch between the front and back camera.",
			"PropertyInspectorPath": "ui/flip.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/flip-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Lens",
			"UUID": "cam.lenslink.streamdeck.lens",
			"Icon": "imgs/actions/lens",
			"Tooltip": "Jump to one lens, or cycle through them.",
			"PropertyInspectorPath": "ui/lens.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/lens-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Zoom",
			"UUID": "cam.lenslink.streamdeck.zoom",
			"Icon": "imgs/actions/zoom",
			"Tooltip": "Key: go to a set zoom. Dial: turn to zoom, press for 1×.",
			"PropertyInspectorPath": "ui/zoom.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/zoom-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"Icon": "imgs/actions/zoom-key",
				"TriggerDescription": {
					"Rotate": "Zoom",
					"Push": "Reset to 1×"
				}
			}
		},
		{
			"Name": "Flashlight",
			"UUID": "cam.lenslink.streamdeck.flashlight",
			"Icon": "imgs/actions/flashlight",
			"Tooltip": "Turn the phone's flashlight on or off.",
			"PropertyInspectorPath": "ui/flashlight.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/flashlight-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Lock",
			"UUID": "cam.lenslink.streamdeck.lock",
			"Icon": "imgs/actions/lock",
			"Tooltip": "Lock what auto is doing right now, or hand it back to auto.",
			"PropertyInspectorPath": "ui/lock.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/lock-key",
					"ShowTitle": false
				}
			]
